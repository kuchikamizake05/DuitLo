# Browser-safe credentials from Supabase Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only: used by app/api/trades/[tradeId]/review; never prefix with NEXT_PUBLIC_
N8N_TRADE_REVIEW_WEBHOOK_URL=https://your-n8n.example/webhook/fintrack-trade-review
N8N_TRADE_REVIEW_SHARED_SECRET=replace-with-a-long-random-secret

# Server only: Groq powers anonymized Smart Insights; never prefix with NEXT_PUBLIC_
GROQ_API_KEY=your-groq-api-key
GROQ_INSIGHTS_MODEL=openai/gpt-oss-20b

# Server only: OpenRouter routes receipt images to Qwen Vision; never prefix with NEXT_PUBLIC_
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_RECEIPT_MODEL=qwen/qwen3.7-flash
OPENROUTER_RECEIPT_FALLBACK_MODEL=qwen/qwen3.7-plus

# Server only: shared route limiter for multi-instance production. Required before public launch.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Emergency single-instance development override; keep false in production.
RATE_LIMIT_ALLOW_LOCAL=false

# Billing is opt-in. Enable only after matching database billing_settings and sandbox verification.
BILLING_ENABLED=false
BILLING_APP_URL=https://your-fintrack-domain.example
BILLING_PRO_PRICE_IDR=
BILLING_PRO_TERM_DAYS=
# Server only: never expose these through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BUSINESS_ID=

# Isolated managed staging project. Never substitute production credentials here.
STAGING_SUPABASE_URL=
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_SUPABASE_DB_PASSWORD=
STAGING_SUPABASE_ACCESS_TOKEN=
STAGING_UPSTASH_REDIS_REST_URL=
STAGING_UPSTASH_REDIS_REST_TOKEN=
STAGING_XENDIT_SECRET_KEY=
STAGING_XENDIT_CALLBACK_TOKEN=
STAGING_XENDIT_BUSINESS_ID=
STAGING_BILLING_PRO_PRICE_IDR=
STAGING_BILLING_PRO_TERM_DAYS=
